<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://mephi3.ru"
xmlns:tns="http://mephi3.ru" elementFormDefault="qualified">
    <xs:element name="Books">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="book" type="tns:BookType" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="BookType">
        <xs:sequence>
            <xs:element name="name" type="xs:string" maxOccurs="1" minOccurs="1"/>
            <xs:element name="author" type="xs:string" maxOccurs="1" minOccurs="1"/>
            <xs:element name="publishDate" type="xs:date" maxOccurs="1" minOccurs="1"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>